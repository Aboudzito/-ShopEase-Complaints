    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a customer support triage assistant. Classify the customer complaint and return ONLY valid JSON with no markdown, no backticks, and no extra text. Use lowercase only for category and urgency.\n\n\nRules:\n- \"category\":\n  - \"refund\": customer wants money back or wants to return an item\n  - \"delivery\": order is late, missing, or the wrong item arrived\n  - \"other\": anything else (questions, feedback, thanks)\n- \"urgency\":\n  - \"high\": customer is angry, item is broken/damaged, or they want action today\n  - \"low\": everything else\n- \"summary\": a single concise sentence summarizing the complaint.\n\nOutput format:\n{\"category\": \"...\", \"urgency\": \"...\", \"summary\": \"...\"}",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "message": "={{ $('On form submission').item.json.Complaints }}"
            }
          ]
        },
        "batching": {}
