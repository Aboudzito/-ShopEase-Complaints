    {
      "parameters": {
        "jsCode": "// Grab the AI text output (adjust .text or .message.content depending on your AI node's output)\nconst raw = $input.first().json.text || $input.first().json.output || $input.first().json.message?.content || \"\";\n\n// Remove markdown code fences if present\nconst cleaned = raw.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\n// Parse into an object\nconst parsed = JSON.parse(cleaned);\n\nreturn [\n  {\n    json: {\n      category: parsed.category.toLowerCase().trim(),\n      urgency: parsed.urgency.toLowerCase().trim(),\n      summary: parsed.summary\n    }\n  }\n];"
      },
